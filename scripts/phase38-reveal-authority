#!/usr/bin/env bash
set -euo pipefail

NAMESPACE='literary-reveal-authority-v1@persian-literary-translation-engine'
PROTOCOL='PLTE-REVEAL-AUTHORITY-V1'

usage() {
  cat >&2 <<'EOF'
Usage:
  phase38-reveal-authority sign <bundle> <reveal-key> <signature> --project <id> --review <id> --authority <principal> --key <ssh-key>
  phase38-reveal-authority verify <bundle> <reveal-key> <signature> --project <id> --review <id> --authority <principal> --allowed-signers <file> [--revocations <file>]
EOF
  exit 2
}

sha256_file() { shasum -a 256 -- "$1" | awk '{print $1}'; }
valid_atom() { [[ "$1" =~ ^[A-Za-z0-9._@:+-]{1,128}$ ]]; }

[[ $# -ge 4 ]] || usage
command=$1; bundle=$2; reveal=$3; signature=$4; shift 4
[[ -f "$bundle" && -f "$reveal" ]] || { echo 'bundle and reveal key must be regular files' >&2; exit 2; }

project='' review='' authority='' key='' allowed='' revocations=''
while [[ $# -gt 0 ]]; do
  case "$1" in
    --project) [[ $# -ge 2 ]] || usage; project=$2; shift 2 ;;
    --review) [[ $# -ge 2 ]] || usage; review=$2; shift 2 ;;
    --authority) [[ $# -ge 2 ]] || usage; authority=$2; shift 2 ;;
    --key) [[ $# -ge 2 ]] || usage; key=$2; shift 2 ;;
    --allowed-signers) [[ $# -ge 2 ]] || usage; allowed=$2; shift 2 ;;
    --revocations) [[ $# -ge 2 ]] || usage; revocations=$2; shift 2 ;;
    *) usage ;;
  esac
done

for atom in "$project" "$review" "$authority"; do valid_atom "$atom" || { echo 'project/review/authority must be non-empty restricted ASCII atoms' >&2; exit 2; }; done
bundle_sha=$(sha256_file "$bundle")
reveal_sha=$(sha256_file "$reveal")
statement=$(printf '%s\nproject=%s\nreview=%s\nbundle_sha256=%s\nreveal_sha256=%s\nauthority=%s\n' "$PROTOCOL" "$project" "$review" "$bundle_sha" "$reveal_sha" "$authority")

case "$command" in
  sign)
    [[ -n "$key" && -f "$key" ]] || { echo 'sign requires --key' >&2; exit 2; }
    [[ ! -e "$signature" ]] || { echo 'signature output already exists; refusing overwrite' >&2; exit 2; }
    tmp=$(mktemp "${TMPDIR:-/tmp}/plte-phase38.XXXXXX")
    trap 'rm -f "$tmp" "$tmp.sig"' EXIT
    printf '%s' "$statement" >"$tmp"
    ssh-keygen -Y sign -f "$key" -n "$NAMESPACE" "$tmp" >/dev/null
    install -m 600 "$tmp.sig" "$signature"
    ;;
  verify)
    [[ -f "$signature" && -n "$allowed" && -f "$allowed" ]] || { echo 'verify requires signature and --allowed-signers' >&2; exit 2; }
    args=(-Y verify -f "$allowed" -I "$authority" -n "$NAMESPACE" -s "$signature")
    if [[ -n "$revocations" ]]; then [[ -f "$revocations" ]] || { echo 'revocations file not found' >&2; exit 2; }; args+=(-r "$revocations"); fi
    printf '%s' "$statement" | ssh-keygen "${args[@]}" >/dev/null
    ;;
  *) usage ;;
esac
